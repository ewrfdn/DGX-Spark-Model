# DeepSeek-V4.1-Flash TP2 (双 DGX Spark) TensorFold P0 优化配置模板
# 用法: cp config/tp2.env.example scripts/local.env (或 scripts/config.tp2.env)，按两台机器实际修改。
#
# 本文件保留已在本集群实测跑通的硬件/网络参数，并默认启用长上下文 TTFT P0 优化组合:
#   - 独立推理镜像 (fbbc9713 + MiaAI-Lab 0001..0068 补丁，GB10 原生硬件 CRC32/SHA256)
#   - KV_SHARD=1 + 自动 POOL=2101248 (每卡仅 ~1.06 GiB，内存容量翻倍、非 owner 盘读写降 5.2x)
#   - Spill v2 磁盘缓存 (SPILL_GIB=64, SPILL_STAGING_MIB=256, SPILL_LOAD_MS=120)
#   - Chunked Prefill + 增量尾巴插队 (FILL_CHUNKS=4, FILL_FIRST=4, FILL_CUT_IN=8192)
#   - ENGRAM_LEAD=1 异步预读 + GRAPH_CAP=128 防显存/主机内存缓慢泄漏

# ---- 集群互联 ----
NODES="sakana@192.168.101.1 sakana@192.168.101.2"   # rank 0 (head) 在前
MASTER_IP="192.168.101.1"                            # rank 0 的 CX7 地址
TP_PORT=29620                                        # 引擎 TP 通信端口

# RDMA_HCA / WORKER_RDMA_HCA: 两台机器命名不对称，必须分开配 (见 部署流程.md §2.1)
#   单轨稳定配置: rocep1s0f0 <-> rocep1s0f1
#   若两条 CX7 直连轨道均已配通并实测稳定，可改为双轨提升 all-gather/KV_SHARD 带宽:
#     RDMA_HCA="rocep1s0f0,roceP2p1s0f0"
#     WORKER_RDMA_HCA="rocep1s0f1,roceP2p1s0f1"
RDMA_HCA="rocep1s0f0"                                # rank 0 (head): rail2 RDMA 设备
WORKER_RDMA_HCA="rocep1s0f1"                         # rank 1 (worker): rail2 RDMA 设备

# NET_IF / WORKER_NET_IF: 仅作对照记录；serve_tp2.sh 默认不传 NCCL_SOCKET_IFNAME (见 部署流程.md §2.1)
NET_IF="enP2p1s0f0np0"
WORKER_NET_IF="enp1s0f1np1"

# ---- 目录(两台路径需一致)----
BASE=/home/sakana/dgx-deepseek-tp2
MODEL_DIR="$BASE/model"        # config/tokenizer/index/encoding/chat_template + 39 分片权重
ENGRAM_DIR="$BASE/engram"      # base checkpoint shard 47/48 (两台文件列表必须一致，建议均为本地实体文件)
ENGINE_DIR="$BASE/engine-bin"  # 仅 USE_IMAGE_ENGINE=0 (宿主机挂载模式) 时使用
KIT_DIR="$BASE/kit"            # 内核包 (AOT cubins、RoPE 表、vision cubin/bias)
CACHE_DIR="$BASE/cache"        # rank-cache/rank<R>of2-<hash>.bin + dsv41_token_map.json
LOG_DIR="$BASE/logs"
LANE=tp2-lane                  # 两台上的容器名

# ---- 推理镜像 (P0 推荐: USE_IMAGE_ENGINE=1) ----
# 先执行 `./scripts/build_image.sh --sync` 构建并同步包含 0001..0068 补丁的推理镜像。
# 若需回退旧的宿主机 /engine 挂载模式: 设 USE_IMAGE_ENGINE=0 且 IMAGE=nvcr.io/nvidia/pytorch:26.07-py3。
USE_IMAGE_ENGINE=1
BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
IMAGE=tensorfold-dsv41:exl3-tp2-latest

# 上游版本 pin (与 docker/Dockerfile 和 Spill v2 身份指纹绑定)
TF_REF=fbbc97132cd004237d9887b8d3185896efaedc5c
INPUTS_REF=59402086381a42c74d53053443224eec2790b4c5
MIAAI_REF=c7f2b85100f0a7b099c92a4e21825e30d93c9c51
MODEL_ID=Mia-AiLab/DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw
MODEL_REVISION=45ee5d0fd106c94a3d77f721e09cbb2f50e5a16b
MODEL_QUANT=exl3-2.9bpw
ENGRAM_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
ENGRAM_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170

# ---- 服务 (OpenAI 兼容) ----
HOST=0.0.0.0
PORT=8080                      # 本机 8000 被 spark-management 占用，故用 8080
SERVED_NAME=deepseek-v4.1-flash
SERVER_FLAGS="--no-thinking --max-tokens 32768 --alias glm-5.3-flash --temperature 1.0 --top-p 1.0 --top-k 20"

# ---- 上下文窗口、KV 池与 KV Sharding (P0 核心优化) ----
# CONTEXT: 单请求最大上下文。head 若同时跑其他服务导致内存逼近 memguard，可改 524288 搭配 POOL=2101248 (常驻 4 个 512K 窗口)
CONTEXT=1048576
# KV_SHARD=1: 压缩 KV 按 owner 分片存放；2,101,248 池每卡仅占 ~1,062 MiB (复制模式需 1,783 MiB)，
#             同时使非 owner 节点的磁盘 Spill 读写量从 890 B/tok 降至 170 B/tok (5.2x 减少)，代价仅 1-4% decode。
KV_SHARD=1
# POOL: 总 KV 池容量 (positions)。留空且 KV_SHARD=1 时自动推导为 2101248 (CONTEXT=1048576 下的两份完整窗口)。
#       若 head 可用内存宽裕，可进一步扩到 3145728 或 4194304 (须为 4096 整数倍)，让更多长对话常驻内存不碰盘。
POOL=""
KV_SHARD_DECODE=""             # 空=fetch (最稳参考实现)；可选 owner / auto
KV_SHARD_CARRY=1               # 1=允许跨分片搬移腾空间 (配合 0040 避免退回冷 Prefill)
KV_SHARD_TWINS=1               # 1=冷 prompt 借用对端空闲行
KV_SHARD_CHECK=1024            # planner 一致性校验周期 (decode rounds)
PARALLEL=4                     # 并发流数
STREAMS=4                      # 必须与 PARALLEL 一致
ROUND_ROWS=16                  # pinned kit 支持的最大 round rows
PROMPT_CACHE_GIB=2             # 内存 snap 句柄预算 (单条 6.38 MiB，2 GiB 足够容纳 300+ 状态)

# ---- Spill v2 硬盘 KV 缓存 (P0 调优参数) ----
# 必须指向两台各自本地 NVMe 上的普通目录 (严禁 NFS / tmpfs / zram / root 属主)
SPILL_GIB=64                   # 每台 Spark 本地 NVMe 上限 (0 = 关闭 Spill)
SPILL_DIR=/home/sakana/dsv41-spill
WORKER_SPILL_DIR=/home/sakana/dsv41-spill
SPILL_FLOOR_GIB=50             # 本地盘始终保留的空闲空间下限 (GiB)
SPILL_QUOTA_GIB=16             # 单会话上限 (0 = 不限)
SPILL_MIN_TOKENS=8192          # 短于此长度的状态不落盘 (建议为 2048 整数倍)
SPILL_STAGING_MIB=256          # P0 调优: 从默认 128 提至 256 MiB (读块槽从 26 扩至 ~62 个 / ~108 MiB)
SPILL_TURNS=4                  # 每会话在磁盘额外保留的历史轮次数
SPILL_LOAD_MS=120              # P0 调优: 单次 service 恢复预算从 40 ms 放宽至 120 ms，降低长上下文恢复切片空泡
SPILL_LOAD_WAIT_MS=30000       # 恢复排队/等池空位最大等待 (ms, 0040)
SPILL_FLUSH_MS=60000           # 优雅停服等待 Spill 刷盘上限 (ms); STOP_TIMEOUT 自动取其秒数 + 30s = 90s
SPILL_WEIGHTS_SHA=1            # 1=按 rank 权重文件 SHA256 绑定 store (首次 O_DIRECT 计算约 1 min 并缓存); 0=仅用 revision

# ---- Prefill / Engram / Graph Cap / RDMA 调优 (P0) ----
# Chunked Prefill + 增量尾巴插队 (0041/0042/0045): 避免冷长 prompt 饿死其他请求或阻塞 Spill 恢复
FILL_CHUNKS=4
FILL_FIRST=4
FILL_ROUNDS=""
FILL_CUT_IN=8192               # 命中缓存后增量尾巴 <= 8192 tokens 的长对话也可直接插队

ENGRAM_LEAD=1                  # TF_DS_ENGRAM_LEAD=1: 双 Engram 层各自独立 reader 提前一 chunk 异步预读 (0035)
GRAPHS=1
GRAPH_CAP=128                  # 0033: 限制 CUDA graph 缓存条数，防止长对话多轮后主机/显存缓慢增长触发 memguard
SIDE=1
PREFETCH=1
ENGRAM_AIO=1
RDMA_RING=1
RDMA_IDLE_S=2                  # 0010: 空闲 2s 后 RDMA proxy 休眠，节省 CPU
RDMA_NAP_US=500
RDMA_CPUS=""                   # 0068: 可选绑核 (如 "0")，留空继承默认亲和性

# ---- 引擎 / NCCL 基础环境变量 (本集群实测跑通值，见 部署流程.md §9.2 / §9.5) ----
# 注意: 不要设 NCCL_SOCKET_IFNAME，不要设 NCCL_IB_DISABLE=1
ENGINE_ENV="NCCL_BUFFSIZE=2097152 NCCL_MIN_NCHANNELS=8 NCCL_MAX_NCHANNELS=8 NCCL_DEBUG=WARN TENSORFOLD_MEMORY_RESERVE_GIB=8 TF_DS_REPLAY_FLOOR=1 TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_RDMA_GID_INDEX=3 NCCL_IB_GID_INDEX=3"
