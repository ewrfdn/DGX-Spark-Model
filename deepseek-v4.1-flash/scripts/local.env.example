# DeepSeek-V4.1-Flash TP2(双机)TensorFold 部署配置模板
# 用法:cp config/tp2.env.example scripts/local.env,按你两台机器的实际情况改
#
# 本文件的值是**已跑通并实测**的配置(2026-10-30),不是方案文档的默认值。
#   head(rank 0) spark-adeb  192.168.101.1   rail2 enP2p1s0f0np0 / RoCE rocep1s0f0
#   worker(rank 1) spark-d705 192.168.101.2  rail2 enp1s0f1np1  / RoCE rocep1s0f1
#   另一条 CX7 链路 rail1: 192.168.100.1 / 192.168.100.2(本部署未用于 TP,见 RDMA_HCA 注释)

# ---- 集群互联 ----
NODES="sakana@192.168.101.1 sakana@192.168.101.2"   # rank 0 在前
MASTER_IP="192.168.101.1"                            # rank 0 的 CX7 地址,worker 用它连回来
TP_PORT=29620                                        # 引擎的 TP 通信端口

# RDMA_HCA / WORKER_RDMA_HCA:两台机器**必须分开配**
#   head 上的设备叫 rocep1s0f0 / roceP2p1s0f0,worker 上叫 rocep1s0f1 / roceP2p1s0f1(差最后一位)
#   只在 head 侧写名字,worker 会报 "NET/IB : No device found" 并静默退回 socket 传输。
RDMA_HCA="rocep1s0f0"                                # rank 0(head):rail2 的 RDMA 设备
WORKER_RDMA_HCA="rocep1s0f1"                         # rank 1(worker):rail2 的 RDMA 设备

# NET_IF / WORKER_NET_IF:仅作对照记录;serve_tp2.sh 默认**不**把它传给 NCCL_SOCKET_IFNAME,
# 因为在本机 nvcr 容器里该变量填任何接口名都报 "Bootstrap : no socket interface found"(详见 部署流程 §2.1)。
NET_IF="enP2p1s0f0np0"
WORKER_NET_IF="enp1s0f1np1"

# ---- 目录(两台必须完全一致)----
BASE=/home/sakana/dgx-deepseek-tp2
MODEL_DIR="$BASE/model"        # config/tokenizer/index/encoding/chat_template + 权重(符号链接或实体文件都行)
ENGRAM_DIR="$BASE/engram"      # base checkpoint 的 shard 47/48(Engram 表,只读);软链接也能用,node_run.sh 会自动挂目标目录
ENGINE_DIR="$BASE/engine-bin"  # 编译产物(tensorfold-native、tf-dsv41-lanes、tf-dsv41-rank-cache 等)
KIT_DIR="$BASE/kit"            # 内核包(AOT cubins、RoPE 表、vision cubin/bias)
CACHE_DIR="$BASE/cache"        # rank-cache/rank<R>of2-<hash>.bin + dsv41_token_map.json
LOG_DIR="$BASE/logs"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
LANE=tp2-lane                  # 两台上的容器名

# ---- 服务(OpenAI 兼容)----
HOST=0.0.0.0
PORT=8080                      # 原方案用 8000;本机 8000 被 spark-management 占用,故改 8080
SERVED_NAME=deepseek-v4.1-flash
# alias:想用 glm-5.3-flash 名字调用就留着;不需要就删掉 --alias
SERVER_FLAGS="--no-thinking --max-tokens 32768 --alias glm-5.3-flash --temperature 1.0 --top-p 1.0 --top-k 20"

# ---- 模型参数(不要随意改)----
CONTEXT=1048576                # 服务窗口 1M
PARALLEL=4                     # 并发流数
STREAMS=4                      # 必须与 PARALLEL 相同,且 rank1 的 --streams 要等于它

# ---- 引擎 / NCCL 环境变量 ----
# 下面这组是**实测跑通**的值,改动前先读 部署流程 §9.2:
#   不要设 NCCL_SOCKET_IFNAME —— 本机 nvcr 容器里填任何接口名都报 "no socket interface found"。
#                                  serve_tp2.sh 默认不传,让 NCCL 按路由表自己挑。
#   不要设 NCCL_IB_DISABLE=1    —— 它会让 NCCL 的 IB wrapper 不初始化,引擎的 RDMA 环随之 VerbsFailed。
#   NCCL_MIN/MAX_NCHANNELS=8    —— 固定 channel 数,避免探测阶段的不稳定。
#   NCCL_BUFFSIZE=2097152       —— 2 MB,够用且省内存。
#   两机数据搬运走引擎的 RDMA 环(参数 --rdma / 变量 TF_RDMA_DEVICES),是 RoCE 线速:
#   ib_write_bw 实测 97.5 Gbps(head→worker)/ 105.5 Gbps(反向),ib_write_lat 1.42 us。
# TENSORFOLD_MEMORY_RESERVE_GIB=8:引擎默认按总内存 10% 预留(121.7 GiB → 12.2 GiB),太大会装不下权重。
# TF_RDMA_GID_INDEX / NCCL_IB_GID_INDEX:两块 CX7 的 RoCE v2 GID 索引都是 3。
ENGINE_ENV="NCCL_BUFFSIZE=2097152 NCCL_MIN_NCHANNELS=8 NCCL_MAX_NCHANNELS=8 NCCL_DEBUG=WARN TENSORFOLD_MEMORY_RESERVE_GIB=8 TF_DS_REPLAY_FLOOR=1 TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_RDMA_GID_INDEX=3 NCCL_IB_GID_INDEX=3"
