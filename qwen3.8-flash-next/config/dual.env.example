# Qwen3.8-Flash-Next 双机（2× DGX Spark）vLLM 部署配置
# 复制为 .env 后使用：cp config/dual.env.example dual/.env
#
# 本文件的值按本机集群实测填写：
#   head   spark-adeb  192.168.101.1  enP2p1s0f0np0  RoCE roceP2p1s0f0  (GID 3 与 5 均为 RoCE v2)
#   worker spark-d705  192.168.101.2  enp1s0f1np1    RoCE rocep1s0f1    (ssh 别名 dgx2-fast)
# 两条 CX7 链路都 UP；这里固定走 192.168.101.0/24 这条（Rail A 备用）。

# ---- 集群互联 ----
HEAD_IP="192.168.101.1"
WORKER_IP="192.168.101.2"
WORKER_USER="sakana"            # 留空 = 与 head 同用户；本机 ssh 别名 dgx2-fast 已配好密钥
IFACE="enP2p1s0f0np0"           # head 侧互联网卡
WORKER_IFACE="enp1s0f1np1"      # worker 侧互联网卡（两端命名不同，必须显式给）
IB_HCA="=roceP2p1s0f0"          # 前缀 = 表示精确匹配单卡；必须指向真实互联的那块 HCA
WORKER_IB_HCA="=rocep1s0f1"
IB_GID_INDEX=3                  # 本机 3 和 5 都是 RoCE v2；若 NCCL 起不来改 5

# ---- 模型 ----
MODEL_ID="nvidia/Qwen3.8-Flash-Next-NVFP4"   # 本机已有（124 GiB，11 shard）
ABLIT=0
SERVED_MODEL_NAME="qwen3.8-flash-next"
MAX_MODEL_LEN=262144            # 原生 262K，不启用 YaRN
YARN_ENABLE=false
GPU_MEMORY_UTILIZATION=0.80     # 0.80 留出 host MemAvailable，切勿无脑拉高
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
PORT=8888
KV_CACHE_DTYPE=fp8              # start.sh 会自动应用 QSA FP8 KV 补丁
MAMBA_SSM_CACHE_DTYPE=bfloat16
TENSOR_PARALLEL_SIZE=2          # 每台 1 个 GB10 × 2 台
ENABLE_EXPERT_PARALLEL=true     # NVFP4 必须开 EP
MM_ENCODER_TP_MODE=data
MTP_NUM_SPECULATIVE_TOKENS=3
IMAGE="vllm/vllm-openai:qwen38-flash-next"
PLE_OFFLOAD=false               # 本机内存不足以 CPU 卸载 51GB PLE 表
MTP_DRAFT_VOCAB="files/draft_vocab_en_code_47k.txt"
MTP_DISABLE_BLOCK_DROP=1
MTP_INDEX_SHARE=true
FP8_DENSE=false
QSA_PROFILE=stock
REQUIRE_IDLE_GPU=true
EVICT_PAGE_CACHE=true
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
MASTER_PORT=50000
NFS_SHARE=false                 # 本机装不了 nfs-kernel-server，必须用 rsync 分发
