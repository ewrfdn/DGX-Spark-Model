# Qwen3.8-Flash-Next 单机（1× DGX Spark）TensorFold 部署配置
# 复制为 .env 使用：cp config/single.env.example <recipe>/.env
#
# 重要：TensorFold 引擎（tensorfold-native 1.1.4）只接受 FP4-Local 量化布局
#   shared_expert.{gate,up,down}_proj 与 attention 投影必须是 MXFP8/group32。
#   本机 ~/models/Qwen3.8-Flash-Next-NVFP4 是 vLLM 布局（这些张量是 BF16），
#   启动会直接报 UnsupportedCheckpoint，因此单机必须用 FP4-Local：
#     hf download nvidia/Qwen3.8-Flash-Next-FP4-Local \
#        --revision b9ce18a6887e18c089fdea8509a33e63429a3300
#   （约 96 GiB）

MODEL_ID=nvidia/Qwen3.8-Flash-Next-FP4-Local
MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300
# WEIGHTS_GIB = 加载时实际占用的 MemAvailable（官方在 Zig 引擎上实测 81 GiB，vision 开）。
# 注意它不是磁盘上的 96 GiB —— 填 96 会让 start.sh 算出 122 GiB 的准入门槛，单机永远起不来。
WEIGHTS_GIB=81
CKPT_GIB=96             # 磁盘上的 checkpoint 总量，prepare.sh 用来检查磁盘余量

# 与本机 GLM 等其它 TensorFold 部署隔离的运行时目录，避免内核缓存/端口互相踩
STATE_DIR=/home/sakana/.local/state/qwen38-single-tf
KERNEL_CACHE=/home/sakana/.cache/tensorfold-qwen38-single-tf
LOG_DIR=/home/sakana/.cache/tensorfold-qwen38-single-tf/logs
CONTAINER_NAME=qwen38-flash-next-tf
IMAGE=tensorfold-qwen38:v1.1.4-eab8582
PORT=8888

# 实测：默认 PARALLEL=5 与本机可用内存不匹配，启动会在权重加载完之后失败：
#   tensorfold: --parallel 5 needs 23.92 GiB for its streams at a 262144-token window,
#               and the CUDA memory budget leaves 22.23 GiB: serve --parallel 4, or lower --context
# 改成 4 后正常起服务（加载 164s，实测 43–52 tok/s）。
PARALLEL=4
