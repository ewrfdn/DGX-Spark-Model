# 决策模型服务环境（拷成 local.env 使用；local.env 已在 .gitignore 里）

# ---- 路径 ----
MODEL_ROOT=/home/sakana/models/decision-models     # 权重 + venv 所在目录
VENV=$MODEL_ROOT/.venv
LOG_DIR=$MODEL_ROOT/logs

# ---- 服务端口（每个进程一个模型）----
PORT_BISON=8011      # bison-1                63 GB
PORT_ELEPHANT=8012   # elephant-1             19 GB
PORT_DECIDER=8013    # pplx-decider-v1.3      52 GB
PORT_FLASH=8014      # pplx-decider-flash     9 GB
PORT_GLIDE=8015      # GLiDE-0.4B             1 GB

# ---- 推理参数 ----
DEVICE=cuda:0
PPLX_MODE=isolated        # separate | isolated（isolated 让多问题共享一次 state 编码）
PPLX_FAST=0               # 1 需要 cuDNN 9.24，当前 aarch64 没有，保持 0
PPLX_MAX_TOKENS=0         # 0 = 不截断（不要在服务端截断长上下文）

# ---- fla/triton 编译所需（见教程 4.3）----
C_INCLUDE_PATH=/tmp/pydev/usr/include
LIBRARY_PATH=/usr/local/cuda/lib64:/lib/aarch64-linux-gnu

# ---- new-api ----
NEWAPI_BASE=http://127.0.0.1:3000
NEWAPI_TOKEN_FILE=$MODEL_ROOT/.newapi_token
